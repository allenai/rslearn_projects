{
  "layers": {
    "sentinel2": {
      "type": "raster",
      "band_sets": [
        {
          "bands": ["B02", "B03", "B04", "B05", "B06", "B07", "B08", "B8A", "B11", "B12"],
          "dtype": "uint16",
          "nodata_value": 0
        }
      ],
      "data_source": {
        "class_path": "rslearn.data_sources.planetary_computer.Sentinel2",
        "ingest": false,
        "init_args": {
          "harmonize": true,
          "query": {
            "eo:cloud_cover": {
              "lte": 90
            }
          }
        },
        "query_config": {
          "space_mode": "INTERSECTS",
          "max_matches": 150
        }
      }
    },
    "sentinel1": {
      "type": "raster",
      "band_sets": [
        {
          "bands": ["vv", "vh"],
          "dtype": "float32"
        }
      ],
      "data_source": {
        "class_path": "rslearn.data_sources.planetary_computer.Sentinel1",
        "ingest": false,
        "init_args": {
          "cache_dir": "cache/planetary_computer",
          "query": {
            "sar:instrument_mode": {
              "eq": "IW"
            },
            "sar:polarizations": {
              "eq": ["VV", "VH"]
            }
          }
        },
        "query_config": {
          "space_mode": "INTERSECTS",
          "max_matches": 150
        }
      }
    },
    "label": {
      "type": "raster",
      "band_sets": [
        {
          "bands": ["class_id"],
          "dtype": "uint8",
          "nodata_value": 255
        }
      ]
    }
  }
}
